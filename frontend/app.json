{
  "expo": {
    "name": "Viniyo:Job Applications Tracker",
    "slug": "careerflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "careerflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.emergent.viniyo",
      "usesAppleSignIn": true,
      "buildNumber": "4",
      "icon": "./assets/images/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:application-intel.emergent.host"
      ],
      "infoPlist": {
        "NSCalendarsUsageDescription": "Viniyo uses your calendar to add interview appointments and job application follow-up reminders, helping you stay organized during your job search.",
        "NSPhotoLibraryUsageDescription": "Viniyo needs access to your photo library so you can choose a profile picture to personalize your account. For example, you can select an existing photo to display on your profile.",
        "NSCameraUsageDescription": "Viniyo uses your camera to let you take a new profile photo directly within the app to personalize your account.",
        "NSFaceIDUsageDescription": "Viniyo uses Face ID to provide quick and secure access to your job application data without entering your password.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Viniyo",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "app.emergent.viniyo",
            "CFBundleURLSchemes": [
              "careerflow"
            ]
          }
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.emergent.viniyo"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#007AFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.vsseshadri.careerflow",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#007AFF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#007AFF",
          "sounds": []
        }
      ],
      "expo-font",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow CareerFlow to access your calendar to add interview events"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      "expo-document-picker",
      "./plugins/withShareExtension",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "appName": "CareerFlow",
      "EXPO_PUBLIC_BACKEND_URL": "https://career-topics.emergent.host"
    }
  }
}
